<Project>

  <!--
    Shared settings for everything under tests/. This file also stops MSBuild's upward search, so
    test projects deliberately do NOT inherit src/ pack metadata — they are never packed or versioned.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- SDK 11 adds a hot-reload browser script to a web app's Debug build, with no endpoint for it here, and the build
         stops -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>

</Project>
